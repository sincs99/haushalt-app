# Pflichtwerte — ohne sie startet docker compose nicht.
# Zufallswerte erzeugen mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_REUSE_GRACE_SECONDS=30
# Secure-Flag des Refresh-Token-Cookies (casa_rt). Standard: automatisch — gesetzt bei
# ENVIRONMENT=production, nicht gesetzt in der Entwicklung (http://localhost).
# Nur überschreiben, wenn Produktion ohne HTTPS getestet wird:
# AUTH_COOKIE_SECURE=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Speicher-Quota pro Haushalt für Uploads (Dokumente, Fotos) in MB
HOUSEHOLD_STORAGE_QUOTA_MB=1024
# KI-Assistent (optional, Rezeptvorschläge und Pflanzenpflege über die Anthropic-API).
# Leer lassen = KI-Funktionen ausgeblendet, die App funktioniert unverändert.
# Der Schlüssel bleibt im Backend; zusätzlich muss ein Admin den Assistenten pro Haushalt einschalten.
ANTHROPIC_API_KEY=
# Kostenschutz: maximale KI-Aufrufe pro Haushalt und Tag (UTC)
AI_DAILY_LIMIT_PER_HOUSEHOLD=50
# Zusätzlich pro Person und Tag (UTC) über alle Haushalte
AI_DAILY_LIMIT_PER_USER=20
