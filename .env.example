# Pflichtwerte — ohne sie startet docker compose nicht.
# Zufallswerte erzeugen mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_REUSE_GRACE_SECONDS=30
# Secure-Flag des Refresh-Token-Cookies (casa_rt). Standard: automatisch — gesetzt bei
# ENVIRONMENT=production, nicht gesetzt in der Entwicklung (http://localhost).
# Nur überschreiben, wenn Produktion ohne HTTPS getestet wird:
# AUTH_COOKIE_SECURE=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Speicher-Quota pro Haushalt für Uploads (Dokumente, Fotos) in MB
HOUSEHOLD_STORAGE_QUOTA_MB=1024
# KI-Assistent (optional, Rezeptvorschläge und Pflanzenpflege über die Anthropic-API).
# Leer lassen = KI-Funktionen ausgeblendet, die App funktioniert unverändert.
# Der Schlüssel bleibt im Backend; zusätzlich muss ein Admin den Assistenten pro Haushalt einschalten.
ANTHROPIC_API_KEY=
# Kostenschutz: maximale KI-Aufrufe pro Haushalt und Tag (UTC)
AI_DAILY_LIMIT_PER_HOUSEHOLD=50
# E-Mail-Versand (Passwort vergessen, E-Mail-Bestätigung). Ohne SMTP_HOST: in der
# Entwicklung werden Mails nur geloggt (MAIL_BACKEND=auto → console), in Produktion
# bleiben die Funktionen ausgeblendet. MAIL_BACKEND: auto | smtp | console | off
MAIL_BACKEND=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (587) | ssl (465) | none (lokales Relay)
SMTP_TLS=starttls
MAIL_FROM=Haushalt App <noreply@example.com>
# Öffentliche Adresse der App für Links in E-Mails; leer = erster Eintrag aus CORS_ORIGINS
APP_BASE_URL=
# Tarife/Abrechnung (nur SaaS-Betrieb). false = Self-Hosting: alle Funktionen, globale Limits oben.
BILLING_ENABLED=false
# Limits der Tarife (0 bei MAX_MEMBERS = unbegrenzt, 0 bei AI = KI nicht enthalten)
PLAN_FREE_MAX_MEMBERS=3
PLAN_FREE_STORAGE_MB=200
PLAN_FREE_AI_DAILY_LIMIT=0
PLAN_PREMIUM_MAX_MEMBERS=0
PLAN_PREMIUM_STORAGE_MB=5120
PLAN_PREMIUM_AI_DAILY_LIMIT=50
PLAN_GRACE_DAYS=3
# Stripe (Web-Zahlung); leer = kein Checkout, Tarife nur manuell über den Plattform-Admin
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
