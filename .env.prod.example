# ============================================================
# Casa Production Environment
# Kopiere zu .env.prod und passe die Werte an!
# ============================================================

# --- Datenbank ---
# Pflicht — ohne Wert startet docker compose nicht.
# Generiere mit: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Authentifizierung ---
# Pflicht — leere oder Platzhalter-Werte werden vom Startup-Check abgelehnt.
# Generiere mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_REUSE_GRACE_SECONDS=30
# Der Refresh-Token ist ein HttpOnly-Cookie mit Secure-Flag (ENVIRONMENT=production).
# Nur für einen HTTP-Test ohne TLS auf false setzen — nie im echten Betrieb:
# AUTH_COOKIE_SECURE=false

# --- CORS ---
# Nur explizite Origins; "*" wird abgelehnt (die API akzeptiert Credentials für den Refresh-Cookie).
CORS_ORIGINS=https://casa.konezciny.com

# --- Web Push (Erinnerungen als Benachrichtigung) ---
# Leer lassen = Push deaktiviert. Generieren (im backend/-Ordner):
#   python -m scripts.generate_vapid_keys
# ACHTUNG: Neue Keys machen alle bestehenden Geräte-Registrierungen ungültig.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt für Push-Services (Apple verlangt eine gültige mailto:/https:-Adresse)
VAPID_SUBJECT=mailto:admin@example.com

# --- KI-Assistent (optional) ---
# API-Schlüssel von https://console.anthropic.com — leer lassen = KI-Funktionen ausgeblendet.
# Wird nur im Backend verwendet; Eingaben (Zutaten, Pflanzenart) gehen an die Anthropic-API,
# sobald ein Admin den Assistenten in den Haushaltseinstellungen einschaltet.
ANTHROPIC_API_KEY=
# Kostenschutz: maximale KI-Aufrufe pro Haushalt und Tag (UTC)
AI_DAILY_LIMIT_PER_HOUSEHOLD=50
# Zusätzlich pro Person und Tag (UTC) über alle Haushalte
AI_DAILY_LIMIT_PER_USER=20

# --- Nginx Proxy Manager Netzwerk ---
# Finde den Namen mit: docker network ls
# Typisch: <npm-ordner>_default (z.B. nginx-proxy-manager_default)
NPM_NETWORK=

# --- Vertrauenswürdige Proxies (echte Client-IP für Rate-Limits und Logs) ---
# Adressbereich des NPM-Netzes (docker network inspect <NPM_NETWORK> → Subnet).
# Mehrere Bereiche mit Komma trennen. Default deckt die Docker-Standardpools 172.17–172.31 ab.
# TRUSTED_PROXY_CIDRS=172.16.0.0/12
# Adressbereich des Compose-Netzes (Frontend-nginx → Backend), meist derselbe Default.
# FORWARDED_ALLOW_IPS=172.16.0.0/12

# --- Docker-Log-Rotation (json-file, pro Container) ---
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=5

# --- Umgebung ---
ENVIRONMENT=production
