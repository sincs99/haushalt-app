{
  "name": "haushalt-app-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:locales && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "check:locales": "node scripts/check-locales.js",
    "pwa:icons": "pwa-assets-generator",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@phosphor-icons/vue": "^2.2.1",
    "axios": "^1.19.0",
    "pinia": "^4.0.2",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "~5.8.3",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
